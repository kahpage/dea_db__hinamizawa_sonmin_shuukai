[{"source": "https://web.archive.org/web/20250522215723/https://mattari-an.net/shu-kai/8th/cutlist/cutlist.html", "type": ["Reliable", "Official"]}]}], "links": ["https://yuzukitty2828.booth.pm/"], "description": "YuzuKittyです。村民集会は二回目の参加になります。よろしくお願いします。"}, {"aliases": ["無限大"], "pen_names": ["りさ∞"], "position": "鹿-20", "media": [{"path": "Q_circle_cuts/d20.jpg", "sources": [{"source": "https://web.archive.org/web/20250522215723/https://mattari-an.net/shu-kai/8th/cutlist/cutlist.html", "type": ["Reliable", "Official"]}]}], "links": ["https://twitter.com/uw8takkun0621"], "description": "ひぐらし中心にグッズ、本あります。新グッズに缶バッジ7種、A4トートバッグ、ミニ缶だします。シール、ポストカード、缶バッジ、シール~村民限定ノベルティあります！無配本に悟圭本、綿流し本2冊[去年と今年]、白黒イラスト集の4冊あります。[ポストカード付き]"}, {"aliases": ["23番市同胞互助組合"], "pen_names": ["ふまい/こｔ/アオイ"], "position": "蝶-01,02", "media": [{"path": "Q_circle_cuts/u01.jpg", "sources": [{"source": "https://web.archive.org/web/20250522215723/https://mattari-an.net/shu-kai/8th/cutlist/cutlist.html", "type": ["Reliable", "Official"]}]}], "links": ["http://pastaparty.starfree.jp/", "https://twitter.com/10th_RGD"], "description": "ローズガンズデイズ10周年記念アンソロジー他、07th作品の同人誌・グッズの頒布を行う合同サークルです。"}, {"aliases": ["nudist village"], "pen_names": ["惰性ちゃん"], "position": "蝶-03,04", "media": [{"path": "Q_circle_cuts/u03.jpg", "sources": [{"source": "https://web.archive.org/web/20250522215723/https://mattari-an.net/shu-kai/8th/cutlist/cutlist.html", "type": ["Reliable", "Official"]}]}], "links": ["https://twitter.com/sikemon_P"], "description": "超超超合同サークルです！スケベあります！グッズあります！たぶんホラーと巨乳売り子もいます！よろしくお願いします！"}, {"aliases": ["クリエイティブＡＨＣ"], "pen_names": ["あまおち総統"], "position": "蝶-05", "media": [{"path": "Q_circle_cuts/u05.jpg", "sources": [{"source": "https://web.archive.org/web/20250522215723/https://mattari-an.net/shu-kai/8th/cutlist/cutlist.html", "type": ["Reliable", "Official"]}]}], "links": ["https://ahcahc.com/", "https://twitter.com/creativeAHC"], "description": "アナログゲームを全力で楽しみ、そして自ら手がけるクリエイター集団「クリエイティブAHC」。オリジナルTRPG・ボードゲーム製作、冒険企画局発行『オールゲーマーズ』の編集担当。ゲムマ08年初出展。代表作『斯くして我は独裁者に成れり』『邪神がこの中にいル』『クトゥルフ神話との邂逅』。2022年6月19日に、07th expansion 公式カードゲーム『ひぐらしのなく頃に－我－』をリリース。"}, {"aliases": ["07thフラグメントワールド＆cadenza:"], "pen_names": ["ぐっち、蒼葉叶音"], "position": "蝶-07,08", "media": [{"path": "Q_circle_cuts/u07.jpg", "sources": [{"source": "https://web.archive.org/web/20250522215723/https://mattari-an.net/shu-kai/8th/cutlist/cutlist.html", "type": ["Reliable", "Official"]}]}], "links": ["https://07thfragmentworld.wixsite.com/fw-3", "https://www.pixiv.net/users/499368", "https://twitter.com/07th_fragment_w"], "description": "07thフラグメントワールド★新イベントの告知★・チラシ ・イベントレポート(新刊含む) ・イベントグッズ の頒布がありますcadenza: 叶音個人誌 ・りかさと ・沙都子本やグッズあります"}, {"aliases": ["えいりあんず"], "pen_names": ["ましまろ"], "position": "蝶-09", "media": [{"path": "Q_circle_cuts/u09.jpg", "sources": [{"source": "https://web.archive.org/web/20250522215723/https://mattari-an.net/shu-kai/8th/cutlist/cutlist.html", "type": ["Reliable", "Official"]}]}], "links": ["https://msmrdaaaaa.booth.pm/", "https://www.pixiv.net/users/15867481", "https://twitter.com/msmrdaaaaa"], "description": "ひぐらし女子（竜宮レナ、古手梨花、北条沙都子、園崎魅音、園崎詩音、羽入）グッズメインうみねこも少しあります。ノベルティーや無料配布もありますのでお立ち寄りだけでもぜひ＾＾"}, {"aliases": ["いちごチョコだいすき"], "pen_names": ["anne/レオンハルト"], "position": "蝶-10", "media": [{"path": "Q_circle_cuts/u10.jpg", "sources": [{"source": "https://web.archive.org/web/20250522215723/https://mattari-an.net/shu-kai/8th/cutlist/cutlist.html", "type": ["Reliable", "Official"]}]}], "links": ["https://twitter.com/oici_ne"], "description": "サークル主anne初参加！レオンハルト、隣卓のましまろさんのよく一緒に遊んでいる雛見沢女子会メンバーで頑張ります！新作の缶バッジ、アクスタ、抱き枕等持っていきます！"}, {"aliases": ["コロコロ転がる"], "pen_names": ["海内圭"], "position": "蝶-11", "media": [{"path": "Q_circle_cuts/u11.jpg", "sources": [{"source": "https://web.archive.org/web/20250522215723/https://mattari-an.net/shu-kai/8th/cutlist/cutlist.html", "type": ["Reliable", "Official"]}]}], "links": ["https://twitter.com/u_umiuchi"], "description": "うみねこ新刊とグッズ、ひぐらしグッズ持っていきます。"}, {"aliases": ["ぽや部屋"], "pen_names":